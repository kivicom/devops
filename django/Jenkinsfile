pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // Клонування гілки final-project з GitHub
                checkout scm
            }
        }

        stage('Tests') {
            steps {
                // Тут могли б бути юніт-тести / лінтери
                sh 'echo "🧪 Тут могли б бути тести застосунку"'
            }
        }

        stage('Build (demo)') {
            steps {
                // Демонстраційний крок замість реальної збірки образу в Jenkins
                echo '🔧 Демонстраційний етап: Docker-образ вже зібрано локально та запушено в ECR, Argo CD розгортає його в EKS.'
            }
        }
    }

    post {
        success {
            echo '✅ CI pipeline успішно завершено'
        }
        failure {
            echo '❌ Помилка під час CI-пайплайну'
        }
    }
}
